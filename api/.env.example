# =============================================================================
# SpinSci API — environment variable reference (.env.example)
#
# Every variable the api/ code reads via os.getenv / os.environ. Values shown
# are the code defaults (or local-dev-friendly values); commented lines are
# optional/off by default. Copy to api/.env and adjust.
#
# NOTE: Many deployment secrets (DB/Redis/MinIO passwords, OSS_JWT_SECRET,
# TURN_SECRET) are GENERATED on the host by scripts/setup_remote.sh for remote
# installs — you do not hand-write them there. This file is the authoritative
# list of what the application understands.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
ENVIRONMENT="local"                       # local | production
DEPLOYMENT_MODE="oss"                     # oss | <hosted>; "oss" enables local credits by default
LOG_LEVEL="DEBUG"                         # DEBUG | INFO | WARNING | ERROR
ENABLE_SIGNUP="true"                      # "false" => invite-only
ENABLE_TELEMETRY="true"                   # "false" to disable product telemetry
AUTH_PROVIDER="local"                     # local | stack

# Comma-separated list of allowed CORS origins (empty = none added)
# CORS_ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"

# -----------------------------------------------------------------------------
# Public URLs / host
# For remote installs these derive from PUBLIC_BASE_URL / PUBLIC_HOST; set the
# derived ones explicitly only for a split deployment.
# -----------------------------------------------------------------------------
BACKEND_API_ENDPOINT="http://localhost:8000"   # falls back to PUBLIC_BASE_URL, then localhost
UI_APP_URL="http://localhost:3010"
# PUBLIC_BASE_URL="https://app.example.com"
# PUBLIC_HOST="app.example.com"
# SERVER_IP=""                            # raw server IPv4 (coturn external-ip, public-vs-private detection)

# -----------------------------------------------------------------------------
# Database & cache (REQUIRED — no default; app fails at import if unset)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# OSS email/password auth (default provider). Generated on remote installs.
OSS_JWT_SECRET="change-me-in-production"
OSS_JWT_EXPIRY_HOURS="720"                # 30 days

# Stack Auth (only when AUTH_PROVIDER=stack)
# STACK_AUTH_PROJECT_ID=""                # public (served to UI via /health)
# STACK_PUBLISHABLE_CLIENT_KEY=""         # public
# STACK_SECRET_SERVER_KEY=""              # SECRET — server-side only
# STACK_AUTH_API_URL="https://api.stack-auth.com"

# -----------------------------------------------------------------------------
# Operational / DevOps
# -----------------------------------------------------------------------------
# scripts/rolling_update.sh sends this via X-SpinSci-Devops-Secret to protected
# operational endpoints. Use a unique random value in production.
SPINSCI_DEVOPS_SECRET="change-me-spinsci-devops-secret"

# Hosted MPS integration (not used in OSS mode)
# SPINSCI_MPS_SECRET_KEY=""
# MPS_API_URL="https://services.muralworksai.com"

# TUNER_BASE_URL="https://api.usetuner.ai"

# -----------------------------------------------------------------------------
# Agent Builder — local agentic workflow generator (OpenAI-compatible API)
# Required only for Agent Builder workflow generation.
# -----------------------------------------------------------------------------
# WORKFLOW_GENERATOR_BASE_URL="https://api.openai.com/v1"
# WORKFLOW_GENERATOR_API_KEY="sk-..."
# WORKFLOW_GENERATOR_MODEL="gpt-4.1-mini"
# WORKFLOW_GENERATOR_TEMPERATURE="0.2"       # omit for reasoning models that reject it
# WORKFLOW_GENERATOR_TIMEOUT_SECONDS="120"
# WORKFLOW_GENERATION_SESSION_TTL_SECONDS="3600"
# WORKFLOW_GENERATION_MAX_MESSAGE_LENGTH="4000"

# -----------------------------------------------------------------------------
# Local credit ledger (enabled by default in OSS mode; replaces MPS billing)
# -----------------------------------------------------------------------------
# LOCAL_CREDITS_ENABLED="true"            # defaults true when DEPLOYMENT_MODE=oss
# CREDIT_USD_PER_MINUTE="0.15"
# MINIMUM_CREDITS_FOR_CALL="15"           # defaults to credits-per-minute
# INITIAL_ORGANIZATION_CREDITS="0"

# -----------------------------------------------------------------------------
# Object storage — MinIO (containerised, default) OR AWS S3
# -----------------------------------------------------------------------------
# MinIO (credentials generated on remote installs)
MINIO_ENDPOINT="localhost:9000"
MINIO_PUBLIC_ENDPOINT="http://localhost:9000"   # browser-facing URL; falls back to PUBLIC_BASE_URL
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="voice-audio"
MINIO_SECURE="false"                      # "true" behind TLS

# AWS S3 (set ENABLE_AWS_S3=true to use instead of MinIO)
ENABLE_AWS_S3="false"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# S3_BUCKET=""
# S3_REGION="us-east-1"
# --- S3-compatible servers (MinIO, rustfs, Ceph, ...) ---
# S3_ENDPOINT_URL=""        # e.g. https://s3.example.com (blank = AWS default)
# S3_SIGNATURE_VERSION=""   # blank = botocore default; "s3v4" if required
# S3_ADDRESSING_STYLE=""    # blank = auto; "path" if the server/TLS requires it

# -----------------------------------------------------------------------------
# WebRTC TURN server (coturn)
# -----------------------------------------------------------------------------
ENABLE_COTURN="false"                     # remote installs force this true
TURN_SECRET="spinsci-turn-secret-change-in-production"   # generated on remote installs
TURN_HOST="localhost"                     # derives from PUBLIC_HOST
TURN_PORT="3478"
TURN_TLS_PORT="5349"
TURN_CREDENTIAL_TTL="86400"               # seconds (24h)
FORCE_TURN_RELAY="false"                  # diagnostic: relay-only ICE candidates
# ENABLE_TURN_LOGGING="false"             # verbose TURN pipeline logging

# -----------------------------------------------------------------------------
# Telephony media WebSocket authentication
#   secret empty           -> auth off
#   secret set, enforce off -> tokens minted/verified; invalid only logged
#   secret set, enforce on  -> invalid/missing tokens rejected (WS close 4401)
# -----------------------------------------------------------------------------
# TELEPHONY_WS_TOKEN_SECRET=""
# TELEPHONY_WS_TOKEN_ENFORCE="false"

# Asterisk ARI (telephony stasis integration)
# ENABLE_ARI_STASIS="false"

# -----------------------------------------------------------------------------
# Tracing / analytics / error reporting (all optional)
# -----------------------------------------------------------------------------
# Langfuse — all four required together, or tracing stays off (half-config raises)
# LANGFUSE_HOST="https://cloud.langfuse.com"
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_PROJECT_ID="cm..."

# PostHog
# POSTHOG_API_KEY="phc_..."
POSTHOG_HOST="https://us.i.posthog.com"

# Sentry
# SENTRY_DSN="https://...@o0.ingest.sentry.io/0"

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# LOG_FILE_PATH=""                        # unset = stdout only
# SERIALIZE_LOG_OUTPUT="false"            # "true" => JSON logs
LOG_ROTATION_SIZE="100 MB"
LOG_RETENTION="7 days"
LOG_COMPRESSION="gz"

# -----------------------------------------------------------------------------
# Concurrency / background delivery tuning
# -----------------------------------------------------------------------------
# DEFAULT_ORG_CONCURRENCY_LIMIT="10"      # max concurrent calls per org
# WEBHOOK_DELIVERY_MAX_ATTEMPTS="5"
# WEBHOOK_DELIVERY_BASE_DELAY_SECONDS="30"
# WEBHOOK_DELIVERY_MAX_DELAY_SECONDS="600"
# WEBHOOK_DELIVERY_TIMEOUT_SECONDS="30"

# -----------------------------------------------------------------------------
# Misc / optional integrations
# -----------------------------------------------------------------------------
# GENDERAPI_API_KEY=""                    # api/services/gender (caller gender detection)
# ASGI_WORKER_ID=""                       # override uvicorn worker id (advanced)
# SPINSCI_DOCS_PATH=""                    # override docs tree path for the MCP docs-search tool
