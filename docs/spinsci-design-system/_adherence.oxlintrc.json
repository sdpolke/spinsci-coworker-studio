{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "doc-page.js",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Serif|Sora))/i]",
        "message": "Font not provided by the design system. Available: Noto Serif, Sora."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDemo|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: onDemo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nav'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDemo|key|ref|className|style|children)$/]",
        "message": "<Nav> doesn't accept that prop. Declared props: onDemo."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpinIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<SpinIcon> doesn't accept that prop. Declared props: name, size, color, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:onDemo|key|ref|className|style|children)$/]",
        "message": "<StatBand> doesn't accept that prop. Declared props: onDemo."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Features": {
        "replaces": []
      },
      "Hero": {
        "replaces": []
      },
      "Nav": {
        "replaces": []
      },
      "PlatformDark": {
        "replaces": []
      },
      "SpinIcon": {
